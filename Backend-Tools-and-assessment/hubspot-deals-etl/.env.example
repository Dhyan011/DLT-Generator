# ============================================================
# HubSpot Deals ETL — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env!
# ============================================================

# ----- HubSpot API -----
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxx-replace-this
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TIMEOUT_SECONDS=30
HUBSPOT_RATE_LIMIT_REQUESTS=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10

# ----- DLT Pipeline -----
PIPELINE_NAME=hubspot_deals
DB_SCHEMA=hubspot_deals

# ----- PostgreSQL (dev) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hubspot_etl
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password

# Aliases expected by config.py
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_etl
DB_USER=etl_user
DB_PASSWORD=etl_password
DB_SCHEMA=hubspot_deals

# ----- Flask / Service -----
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
SERVICE_PORT=5200
SERVICE_ENV=dev
HOST=0.0.0.0

# ----- DLT internals -----
DLT_PIPELINE_NAME=hubspot_deals
DLT_WORKING_DIR=.dlt

# ----- Job settings -----
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7

# ----- Logging -----
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=

# ----- Production overrides (uncomment when deploying) -----
# FLASK_ENV=production
# FLASK_DEBUG=false
# SECRET_KEY=your-strong-production-secret
# POSTGRES_PASSWORD=your-production-password